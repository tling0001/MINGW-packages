+#include "config.h"
+#include "SharedMemory.h"
+
+#if OS(WINDOWS)
+
+#include <windows.h>
+#include <wtf/StdLibExtras.h>
+#include <wtf/win/Win32Handle.h>
+
+namespace WebCore {
+
+RefPtr<SharedMemory> SharedMemory::allocate(size_t size)
+{
+    if (!size)
+        return nullptr;
+
+    HANDLE mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+        static_cast<DWORD>(static_cast<uint64_t>(size) >> 32),
+        static_cast<DWORD>(size), nullptr);
+    if (!mapping)
+        return nullptr;
+
+    void* data = MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, size);
+    if (!data) {
+        CloseHandle(mapping);
+        return nullptr;
+    }
+
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_size = size;
+    instance->m_handle = Win32Handle::adopt(mapping);
+    return instance;
+}
+
+RefPtr<SharedMemory> SharedMemory::map(Handle&& handle, Protection protection, CopyOnWrite copyOnWrite)
+{
+    DWORD access = copyOnWrite == CopyOnWrite::Yes ? FILE_MAP_COPY
+        : protection == Protection::ReadOnly ? FILE_MAP_READ : FILE_MAP_WRITE;
+    void* data = MapViewOfFile(handle.m_handle.get(), access, 0, 0, handle.size());
+    if (!data)
+        return nullptr;
+
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_size = handle.size();
+    instance->m_handle = WTF::move(handle.m_handle);
+    return instance;
+}
+
+SharedMemory::~SharedMemory()
+{
+    if (m_data)
+        UnmapViewOfFile(m_data);
+}
+
+auto SharedMemory::createHandle(Protection) -> std::optional<Handle>
+{
+    if (!m_handle)
+        return std::nullopt;
+
+    // Win32Handle's copy constructor duplicates the mapping handle in this process.
+    return Handle(Win32Handle { m_handle }, m_size);
+}
+
+} // namespace WebCore
+
+#endif // OS(WINDOWS)
