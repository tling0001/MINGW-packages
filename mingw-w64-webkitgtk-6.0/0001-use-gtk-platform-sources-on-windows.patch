+{ }
+
+MappedFileData& MappedFileData::operator=(MappedFileData&& other)
+{
+    if (this == &other)
+        return *this;
+    if (!m_fileData.empty())
+        UnmapViewOfFile(m_fileData.data());
+    m_fileData = std::exchange(other.m_fileData, { });
+    m_isValid = std::exchange(other.m_isValid, false);
+    return *this;
+}
+
+MappedFileData::~MappedFileData()
+{
+    if (!m_fileData.empty())
