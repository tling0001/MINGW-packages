+/* Windows virtual-memory implementation for the GTK port. */
+#include "config.h"
+#include <wtf/OSAllocator.h>
+
+#include <windows.h>
+#include <cstring>
+#include <wtf/Assertions.h>
+#include <wtf/PageBlock.h>
+
+namespace WTF {
+
+static DWORD pageProtection(bool writable, bool executable)
+{
+    if (executable)
+        return writable ? PAGE_EXECUTE_READWRITE : PAGE_EXECUTE_READ;
+    return writable ? PAGE_READWRITE : PAGE_READONLY;
+}
+
+void* OSAllocator::tryReserveAndCommit(size_t bytes, Usage, void* address, bool writable, bool executable, bool, unsigned guardPages)
+{
+    size_t guardSize = guardPages * pageSize();
+    size_t totalSize = bytes + guardSize * 2;
+    auto* base = static_cast<uint8_t*>(VirtualAlloc(address ? static_cast<uint8_t*>(address) - guardSize : nullptr, totalSize, MEM_RESERVE, PAGE_NOACCESS));
+    if (!base)
+        return nullptr;
+    auto* result = base + guardSize;
+    if (!VirtualAlloc(result, bytes, MEM_COMMIT, pageProtection(writable, executable))) {
+        VirtualFree(base, 0, MEM_RELEASE);
+        return nullptr;
+    }
+    return result;
+}
+
+void* OSAllocator::tryReserveAndCommitImpl(size_t bytes, Usage usage, void* address, bool writable, bool executable, bool jitCageEnabled, unsigned guards, bool uncommitted)
+{
+    UNUSED_PARAM(jitCageEnabled);
+    if (uncommitted)
+        return tryReserveUncommitted(bytes, usage, address, writable, executable, jitCageEnabled, guards);
+    return tryReserveAndCommit(bytes, usage, address, writable, executable, jitCageEnabled, guards);
+}
+
+void* OSAllocator::tryReserveUncommitted(size_t bytes, Usage, void* address, bool, bool, bool, unsigned guards)
+{
+    size_t guardSize = guards * pageSize();
+    size_t totalSize = bytes + guardSize * 2;
+    auto* base = static_cast<uint8_t*>(VirtualAlloc(address ? static_cast<uint8_t*>(address) - guardSize : nullptr, totalSize, MEM_RESERVE, PAGE_NOACCESS));
+    return base ? base + guardSize : nullptr;
+}
+
+void* OSAllocator::reserveUncommitted(size_t bytes, Usage usage, void* address, bool writable, bool executable, bool jitCageEnabled, unsigned guards)
+{
+    void* result = tryReserveUncommitted(bytes, usage, address, writable, executable, jitCageEnabled, guards);
+    RELEASE_ASSERT(result);
+    return result;
+}
+
+void* OSAllocator::tryReserveUncommittedAligned(size_t bytes, size_t alignment, Usage, void* address, bool, bool, bool, unsigned guards)
+{
+    ASSERT(!(alignment & (alignment - 1)) && alignment >= pageSize());
+    size_t guardSize = guards * pageSize();
+    size_t totalSize = bytes + alignment + guardSize * 2;
+    auto* base = static_cast<uint8_t*>(VirtualAlloc(address, totalSize, MEM_RESERVE, PAGE_NOACCESS));
+    if (!base)
+        return nullptr;
+    uintptr_t candidate = reinterpret_cast<uintptr_t>(base + guardSize);
+    uintptr_t aligned = (candidate + alignment - 1) & ~(alignment - 1);
+    return reinterpret_cast<void*>(aligned);
+}
+
+void* OSAllocator::reserveAndCommit(size_t bytes, Usage usage, void* address, bool writable, bool executable, bool jitCageEnabled, unsigned guards)
+{
+    void* result = tryReserveAndCommit(bytes, usage, address, writable, executable, jitCageEnabled, guards);
+    RELEASE_ASSERT(result);
+    return result;
+}
+
+void OSAllocator::commit(void* address, size_t bytes, bool writable, bool executable)
+{
+    RELEASE_ASSERT(VirtualAlloc(address, bytes, MEM_COMMIT, pageProtection(writable, executable)));
+}
+
+void OSAllocator::decommit(void* address, size_t bytes)
+{
+    RELEASE_ASSERT(VirtualFree(address, bytes, MEM_DECOMMIT));
+}
+
+void OSAllocator::releaseDecommitted(void* address, size_t, unsigned guards)
+{
+    auto* base = static_cast<uint8_t*>(address) - guards * pageSize();
+    RELEASE_ASSERT(VirtualFree(base, 0, MEM_RELEASE));
+}
+
+void OSAllocator::hintMemoryNotNeededSoon(void* address, size_t bytes)
+{
+    decommit(address, bytes);
+}
+
+bool OSAllocator::tryProtect(void* address, size_t bytes, bool readable, bool writable)
+{
+    DWORD oldProtection;
+    DWORD protection = !readable ? PAGE_NOACCESS : writable ? PAGE_READWRITE : PAGE_READONLY;
+    return VirtualProtect(address, bytes, protection, &oldProtection);
+}
+
+void OSAllocator::protect(void* address, size_t bytes, bool readable, bool writable)
+{
+    RELEASE_ASSERT(tryProtect(address, bytes, readable, writable));
+}
+
+void OSAllocator::zeroFill(void* base, size_t size)
+{
+    std::memset(base, 0, size);
+}
+
