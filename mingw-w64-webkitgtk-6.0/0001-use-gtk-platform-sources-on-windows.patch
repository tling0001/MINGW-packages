@@ -185,6 +189,50 @@
 
     return MappedFileData { WTF::move(fileData) };
 }
-#endif // HAVE(MMAP)
+#elif OS(WINDOWS) && PLATFORM(GTK)
+std::optional<MappedFileData> FileHandle::map(MappedFileMode mapMode, FileOpenMode openMode)
+{
+    if (!m_handle)
+        return { };
+
+    struct stat fileStat;
+    if (fstat(platformHandle(), &fileStat))
+        return { };
+
+    size_t size;
+    if (!WTF::convertSafely(fileStat.st_size, size))
+        return { };
+    if (!size)
+        return MappedFileData::emptyFile();
+
+    auto nativeHandle = reinterpret_cast<HANDLE>(_get_osfhandle(platformHandle()));
+    if (nativeHandle == INVALID_HANDLE_VALUE)
+        return { };
+
+    DWORD protection = PAGE_READONLY;
+    DWORD access = FILE_MAP_READ;
+    if (mapMode == MappedFileMode::Private) {
+        protection = PAGE_WRITECOPY;
+        access = FILE_MAP_COPY;
+    } else if (openMode != FileOpenMode::Read) {
+        protection = PAGE_READWRITE;
+        access = FILE_MAP_READ | FILE_MAP_WRITE;
+    }
+
+    HANDLE mapping = CreateFileMappingW(nativeHandle, nullptr, protection,
+        static_cast<DWORD>(static_cast<uint64_t>(size) >> 32), static_cast<DWORD>(size), nullptr);
+    if (!mapping)
+        return { };
+
+    void* address = MapViewOfFile(mapping, access, 0, 0, size);
+    if (!address) {
+        CloseHandle(mapping);
+        return { };
+    }
+    // The mapped view keeps the section object alive after its handle is closed.
+    CloseHandle(mapping);
+    return MappedFileData { std::span<uint8_t> { static_cast<uint8_t*>(address), size } };
+}
+#endif // HAVE(MMAP) / GTK Win32 mapping
 
 } // WTF::FileSystemImpl
