 namespace WTF {
 
+#if OS(WINDOWS) && PLATFORM(GTK)
+static Seconds NODELETE fileTimeToSeconds(const FILETIME& value)
+{
+    ULARGE_INTEGER ticks;
+    ticks.LowPart = value.dwLowDateTime;
+    ticks.HighPart = value.dwHighDateTime;
+    return Seconds(static_cast<double>(ticks.QuadPart) / 10000000.0);
+}
+
+std::optional<CPUTime> CPUTime::get()
+{
+    FILETIME creationTime;
+    FILETIME exitTime;
+    FILETIME kernelTime;
+    FILETIME userTime;
+    if (!GetProcessTimes(GetCurrentProcess(), &creationTime, &exitTime, &kernelTime, &userTime))
+        return std::nullopt;
+    return CPUTime { MonotonicTime::now(), fileTimeToSeconds(userTime), fileTimeToSeconds(kernelTime) };
+}
+
+Seconds CPUTime::forCurrentThread()
+{
+    FILETIME creationTime;
+    FILETIME exitTime;
+    FILETIME kernelTime;
+    FILETIME userTime;
+    if (!GetThreadTimes(GetCurrentThread(), &creationTime, &exitTime, &kernelTime, &userTime))
+        return Seconds(0);
+    return fileTimeToSeconds(userTime) + fileTimeToSeconds(kernelTime);
+}
+#else
 static Seconds NODELETE timevalToSeconds(const struct timeval& value)
 {
     return Seconds(value.tv_sec) + Seconds::fromMicroseconds(value.tv_usec);
