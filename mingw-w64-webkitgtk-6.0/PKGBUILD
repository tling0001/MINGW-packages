# WebKit's source tarball contains links that bsdtar cannot materialize on Windows.
# Follow the extraction workaround used by mingw-w64-qemu.
noextract=("webkitgtk-${pkgver}.tar.xz")

prepare() {
  local source_dir="${srcdir}/webkitgtk-${pkgver}"

  rm -rf "${source_dir}"
  # Some vendored symlinks fail to extract on Windows; the required build sources
  # are regular files, so tolerate those link-only errors and validate key inputs.
  tar --exclude="*/Source/ThirdParty/skia/src/ports/fontations/Cargo.toml" \
    -xf "${srcdir}/webkitgtk-${pkgver}.tar.xz" -C "${srcdir}" || true

  for patch_file in \
    "${srcdir}/0001-use-gtk-platform-sources-on-windows.patch" \
    "${srcdir}/0002-fix-glib-header-declarations.patch" \
    "${srcdir}/0003-fix-windows-gtk-wtf-posix-compatibility.patch" \
    "${srcdir}/0004-add-win32-virtual-memory-support.patch" \
    "${srcdir}/0005-fix-windows-gtk-posix-locale-and-cloexec.patch" \
    "${srcdir}/0006-use-glib-for-portable-temporary-files.patch" \
    "${srcdir}/0007-win32-unistd-extras.patch" \
    "${srcdir}/0008-win32-memory-footprint.patch" \
    "${srcdir}/0009-link-psapi-for-windows-gtk.patch" \
    "${srcdir}/0010-fix-windows-build-warning.patch" \
    "${srcdir}/0011-guard-unix-vulkan-device-identification.patch" \
    "${srcdir}/0012-fix-mingw-arm64-unwind-flag.patch" \
    "${srcdir}/0013-use-windows-platform-for-angle.patch" \
    "${srcdir}/0014-fix-windows-perl-bindings-generation.patch" \
    "${srcdir}/0015-remove-posix-includes-from-glib-cache-data.patch"; do
    patch -d "${source_dir}" -Np1 -i "${patch_file}" || return 1
  done

  [[ -f "${source_dir}/CMakeLists.txt" ]] || {
    error "WebKit source extraction did not produce the top-level CMakeLists.txt"
    return 1
  }
  [[ -f "${source_dir}/Source/WebKit/CMakeLists.txt" ]] || {
    error "WebKit source extraction is missing Source/WebKit/CMakeLists.txt"
    return 1
  }
  [[ -f "${source_dir}/Source/JavaScriptCore/CMakeLists.txt" ]] || {
    error "WebKit source extraction is missing Source/JavaScriptCore/CMakeLists.txt"
    return 1
  }

}

build() {
  local compiler_warning_flags="-Wno-ignored-attributes"
  case "${MSYSTEM}" in
    CLANG64|CLANGARM64)
      compiler_warning_flags+=" -Wno-unsafe-buffer-usage"
      ;;
  esac

  local -a cmake_args=(
    -GNinja
    -DPORT=GTK
    -DUSE_GTK4=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DCMAKE_INSTALL_LIBDIR=lib
    -DCMAKE_PREFIX_PATH="${MINGW_PREFIX}"
    -DENABLE_DOCUMENTATION=OFF
    -DENABLE_MINIBROWSER=ON
    -DENABLE_INTROSPECTION=OFF
    -DENABLE_GAMEPAD=OFF
    -DENABLE_GEOLOCATION=OFF
    -DENABLE_SPELLCHECK=OFF
    -DENABLE_SPEECH_SYNTHESIS=OFF
    -DENABLE_WEB_AUDIO=OFF
    -DENABLE_WEB_RTC=OFF
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF
    -DENABLE_X11_TARGET=OFF
    -DENABLE_WAYLAND_TARGET=OFF
    -DENABLE_QUARTZ_TARGET=OFF
    -DENABLE_JOURNALD_LOG=OFF
    -DUSE_LIBBACKTRACE=OFF
    -DUSE_LIBDRM=OFF
    -DUSE_SYSTEM_SYSPROF_CAPTURE=NO
    -DUSE_SYSPROF_CAPTURE=OFF
    -DUSE_VULKAN=ON
    -DUSE_SYSTEM_MALLOC=OFF
    -DUSE_MIMALLOC=ON
    "-DCMAKE_C_FLAGS=${compiler_warning_flags}"
    "-DCMAKE_CXX_FLAGS=${compiler_warning_flags}"
  )

  mkdir -p "${srcdir}/build-${MSYSTEM}"
  cd "${srcdir}/build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake "${cmake_args[@]}" "${srcdir}/webkitgtk-${pkgver}"

  cmake --build . --parallel "${NUMBER_OF_PROCESSORS:-2}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/build-${MSYSTEM}"

  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/WebKit/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/JavaScriptCore/COPYING.LIB" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING.LIB"
}
