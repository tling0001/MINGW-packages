+#include "config.h"
+#include "ArgumentCodersWin.h"
+
+#include "Decoder.h"
+#include "Encoder.h"
+#include <wtf/Assertions.h>
+#include <wtf/unix/UnixFileDescriptor.h>
+
+namespace IPC {
+
+void ArgumentCoder<UnixFileDescriptor>::encode(Encoder& encoder, const UnixFileDescriptor& descriptor)
+{
+    // GTK on Windows does not transfer POSIX descriptors. Its shared-memory
+    // renderer path must therefore send an invalid descriptor for each frame.
+    RELEASE_ASSERT(!descriptor);
+    encoder << false;
+}
+
+void ArgumentCoder<UnixFileDescriptor>::encode(Encoder& encoder, UnixFileDescriptor&& descriptor)
+{
+    RELEASE_ASSERT(!descriptor);
+    encoder << false;
+}
+
+std::optional<UnixFileDescriptor> ArgumentCoder<UnixFileDescriptor>::decode(Decoder& decoder)
+{
+    auto hasDescriptor = decoder.decode<bool>();
+    if (!hasDescriptor || *hasDescriptor)
+        return std::nullopt;
+    return UnixFileDescriptor { };
+}
+
+} // namespace IPC
