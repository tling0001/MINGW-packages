+#include "config.h"
+#include <wtf/MappedFileData.h>
+
+#if OS(WINDOWS) && PLATFORM(GTK)
+#include <windows.h>
+#endif
+#include <utility>
+
+namespace WTF::FileSystemImpl {
+
+#if HAVE(MMAP)
+MappedFileData::MappedFileData(MmapSpan<uint8_t>&& fileData)
+    : m_fileData(WTF::move(fileData))
+    , m_isValid(true)
+{ }
+
+MappedFileData::~MappedFileData() = default;
+#elif OS(WINDOWS) && PLATFORM(GTK)
+MappedFileData::MappedFileData(std::span<uint8_t> fileData)
+    : m_fileData(fileData)
+    , m_isValid(true)
+{ }
+
+MappedFileData::MappedFileData(MappedFileData&& other)
+    : m_fileData(std::exchange(other.m_fileData, { }))
+    , m_isValid(std::exchange(other.m_isValid, false))
+{ }
+
+MappedFileData& MappedFileData::operator=(MappedFileData&& other)
+{
+    if (this == &other)
+        return *this;
+    if (!m_fileData.empty())
+        UnmapViewOfFile(m_fileData.data());
+    m_fileData = std::exchange(other.m_fileData, { });
+    m_isValid = std::exchange(other.m_isValid, false);
+    return *this;
+}
+
+MappedFileData::~MappedFileData()
+{
+    if (!m_fileData.empty())
+        UnmapViewOfFile(m_fileData.data());
+}
+#endif
+
+} // namespace WTF::FileSystemImpl
