+++ b/Source/WebCore/bindings/scripts/generate-bindings-all.pl
@@ -188,0 +189,14 @@
+if ($^O eq 'MSWin32') {
+    # Native Windows Perl does not implement fork(). Generate bindings in-process.
+    while (@resolvedIdlFilesToUpdate) {
+        my $batchCount = int(($totalCount + $numOfJobs - 1) / $numOfJobs) || 1;
+        my @files = splice(@resolvedIdlFilesToUpdate, 0, $batchCount);
+        for (@files) {
+            $currentCount++;
+            printProgress("[$currentCount/$totalCount] " . basename($_));
+        }
+        generateBindings(@files);
+    }
+    exit 0;
+}
