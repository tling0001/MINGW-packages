--- a/Source/WTF/wtf/Fnmatch.h
+++ b/Source/WTF/wtf/Fnmatch.h
@@ -0,0 +1,83 @@
+/* Minimal POSIX fnmatch(3) compatibility for Windows builds.
+ * Supports the wildcard syntax used by WebKit and xdgmime.
+ */
+#pragma once
+
+#if defined(_WIN32)
+static inline int wtfFnmatchMatchBracket(const char** pattern, unsigned char character)
+{
+    const char* p = *pattern;
+    int negate = 0;
+    int matched = 0;
+    if (*p == '!' || *p == '^') {
+        negate = 1;
+        ++p;
+    }
+    if (*p == ']') {
+        matched = character == ']';
+        ++p;
+    }
+    while (*p && *p != ']') {
+        unsigned char first = (unsigned char)*p++;
+        if (first == '\\' && *p)
+            first = (unsigned char)*p++;
+        if (*p == '-' && p[1] && p[1] != ']') {
+            ++p;
+            unsigned char last = (unsigned char)*p++;
+            if (last == '\\' && *p)
+                last = (unsigned char)*p++;
+            if (character >= first && character <= last)
+                matched = 1;
+        } else if (character == first)
+            matched = 1;
+    }
+    if (*p != ']')
+        return -1;
+    *pattern = p + 1;
+    return negate ? !matched : matched;
+}
+
+static inline int fnmatch(const char* pattern, const char* string, int flags)
+{
+    (void)flags;
+    while (*pattern) {
+        if (*pattern == '*') {
+            while (*pattern == '*')
+                ++pattern;
+            if (!*pattern)
+                return 0;
+            do {
+                if (!fnmatch(pattern, string, 0))
+                    return 0;
+            } while (*string++);
+            return 1;
+        }
+        if (!*string)
+            return 1;
+        if (*pattern == '?') {
+            ++pattern;
+            ++string;
+            continue;
+        }
+        if (*pattern == '[') {
+            const char* next = pattern + 1;
+            int result = wtfFnmatchMatchBracket(&next, (unsigned char)*string);
+            if (result < 0 || !result)
+                return 1;
+            pattern = next;
+            ++string;
+            continue;
+        }
+        if (*pattern == '\\' && pattern[1])
+            ++pattern;
+        if ((unsigned char)*pattern++ != (unsigned char)*string++)
+            return 1;
+    }
+    return *string ? 1 : 0;
+}
+#else
+#include <fnmatch.h>
+#endif
