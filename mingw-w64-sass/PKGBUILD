# Maintainer: Your Name <you@example.com>

_realname=sass
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.104.1
pkgrel=1
pkgdesc="Dart Sass compiled to pure JavaScript for MinGW"
arch=('any')
url="https://sass-lang.com/"
license=('MIT')
depends=("${MINGW_PACKAGE_PREFIX}-nodejs")
makedepends=("${MINGW_PACKAGE_PREFIX}-nodejs")
source=("https://registry.npmjs.org/${_realname}/-/${_realname}-${pkgver}.tgz")
sha256sums=('7a935a71c27e77910a61fe079641b034ac11aaf2b30071e338f9948d9fe871d7')

package() {
  cd "${srcdir}"

  # Set a local npm cache folder so it doesn't pollute your home directory during build
  export npm_config_cache="${srcdir}/npm-cache"

  # Install global binaries and module files into the MSYS2 pkg structure
  npm install -g --prefix="${pkgdir}${MINGW_PREFIX}" "${srcdir}/${_realname}-${pkgver}.tgz"

  # Remove hardcoded pkgdir paths that npm injects into package.json files
  find "${pkgdir}${MINGW_PREFIX}" -name "package.json" -exec sed -i "s|${pkgdir}||g" {} +
}
