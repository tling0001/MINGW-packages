# Maintainer: Your Name <you@example.com>
_realname=winq-emu
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=11.0.0
pkgrel=1
pkgdesc="WINQ-EMU components - virglrenderer and QEMU (${MINGW_CHOST})"
arch=('any')
mingw_arch=('mingw64' 'ucrt64')
url="https://github.com/cmspam/winq-emu"
license=('GPL-2.0-or-later' 'MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libepoxy"
  "${MINGW_PACKAGE_PREFIX}-spice-protocol"
  "${MINGW_PACKAGE_PREFIX}-usbredir"
  "${MINGW_PACKAGE_PREFIX}-SDL2"
  "${MINGW_PACKAGE_PREFIX}-pixman"
  "${MINGW_PACKAGE_PREFIX}-zstd"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-vulkan-loader"
)
makedepends=(
  "git"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-gcc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkg-config"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-yaml"
  "${MINGW_PACKAGE_PREFIX}-python-sphinx"
  "${MINGW_PACKAGE_PREFIX}-vulkan-headers"
)
source=(
  "winq-emu-virglrenderer::git+https://github.com/tling0001/winq-emu-virglrenderer.git#tag=${pkgver}"
  "winq-emu-qemu::git+https://github.com/tling0001/winq-emu-qemu.git#tag=${pkgver}"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  local _srcdir=$(cygpath -u "$srcdir")

  # Ensure git line-endings do not break script execution on Windows
  cd "${_srcdir}/winq-emu-qemu"
  git config core.autocrlf false
  git config core.symlinks true
  git checkout -f
  git submodule update --init --recursive || true
}

build() {
  # Force MSYS2 toolchain environment
  export PATH="${MINGW_PREFIX}/bin:$PATH"
  export CC="${MINGW_PREFIX}/bin/gcc.exe"
  export CXX="${MINGW_PREFIX}/bin/g++.exe"
  export PKG_CONFIG="${MINGW_PREFIX}/bin/pkg-config.exe"
  export PYTHON="${MINGW_PREFIX}/bin/python3.exe"

  # POSIX path for cd/meson, Mixed-Windows path for QEMU python scripts[cite: 1]
  local _srcdir_posix=$(cygpath -u "$srcdir")
  local _qemu_srcdir_win=$(cygpath -m "$srcdir/winq-emu-qemu")

  # 1. Build virglrenderer
  cd "${_srcdir_posix}/winq-emu-virglrenderer"
  
  export MSYS2_ARG_CONV_EXCL="*"
  meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=plain \
    -Dvenus=true \
    -Dvideo=true \
    -Dtests=false \
    . "${_srcdir_posix}/build-virglrenderer"

  meson compile -C "${_srcdir_posix}/build-virglrenderer"

  # 2. Build QEMU
  cd "${_srcdir_posix}/winq-emu-qemu"
  
  # Bypass MSYS2 automatic path rewriting for configure options
  unset MSYS2_ARG_CONV_EXCL

  # Running configure with explicit Windows-style path prevents D:/d/_/... duplication[cite: 1]
  python3 "${_qemu_srcdir_win}/configure" \
    --prefix="${MINGW_PREFIX}" \
    --target-list=x86_64-softmmu \
    --enable-virglrenderer \
    --enable-opengl \
    --enable-sdl \
    --disable-werror \
    --python="${MINGW_PREFIX}/bin/python3.exe"

  export MSYS2_ARG_CONV_EXCL="*"

  make -j$(nproc)
}

package() {
  local _srcdir_posix=$(cygpath -u "$srcdir")

  # Install virglrenderer DLLs and headers
  meson install -C "${_srcdir_posix}/build-virglrenderer" --destdir "$pkgdir"

  # Install QEMU binaries and artifacts
  cd "${_srcdir_posix}/winq-emu-qemu"
  make DESTDIR="$pkgdir" install

  # Rename installed QEMU binaries from qemu-* to winq-emu-* and enforce .exe extension
  local _bin_dir="${pkgdir}${MINGW_PREFIX}/bin"
  if [ -d "${_bin_dir}" ]; then
    for f in "${_bin_dir}"/qemu-*; do
      if [ -f "$f" ]; then
        local filename="${f##*/qemu-}"
        local base_name="${filename%.exe}"
        mv "$f" "${_bin_dir}/winq-emu-${base_name}.exe"
      fi
    done
  fi
}
