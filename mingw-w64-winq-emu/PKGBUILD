# Maintainer: Your Name <you@example.com>
_realname=winq-emu
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=11.0.0
pkgrel=1
pkgdesc="WINQ-EMU components - virglrenderer and QEMU (${MINGW_CHOST})"
arch=('any')
url="https://github.com/cmspam/winq-emu"
license=('GPL-2.0-or-later' 'MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libepoxy"
  "${MINGW_PACKAGE_PREFIX}-spice-protocol"
  "${MINGW_PACKAGE_PREFIX}-usbredir"
  "${MINGW_PACKAGE_PREFIX}-SDL2"
  "${MINGW_PACKAGE_PREFIX}-pixman"
  "${MINGW_PACKAGE_PREFIX}-zstd"
  "${MINGW_PACKAGE_PREFIX}-glib2"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkg-config"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-yaml"
  "${MINGW_PACKAGE_PREFIX}-python-sphinx"
)
source=(
  "winq-emu-virglrenderer-${pkgver}.tar.gz::https://github.com/tling0001/winq-emu-virglrenderer/archive/refs/tags/${pkgver}.tar.gz"
  "winq-emu-qemu-${pkgver}.tar.gz::https://github.com/tling0001/winq-emu-qemu/archive/refs/tags/${pkgver}.tar.gz"
)
noextract=(
  "winq-emu-virglrenderer-${pkgver}.tar.gz"
  "winq-emu-qemu-${pkgver}.tar.gz"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  # Manually extract tarballs using tar to create missing subdirectories automatically
  mkdir -p "$srcdir/winq-emu-virglrenderer-${pkgver}"
  tar -xzf "$srcdir/winq-emu-virglrenderer-${pkgver}.tar.gz" -C "$srcdir"

  mkdir -p "$srcdir/winq-emu-qemu-${pkgver}"
  tar -xzf "$srcdir/winq-emu-qemu-${pkgver}.tar.gz" -C "$srcdir"
}

build() {
  # 1. Build virglrenderer
  MSYS2_ARG_CONV_EXCL="*" meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=plain \
    -Dvenus=true \
    -Dvideo=true \
    -Dtests=false \
    "$srcdir/winq-emu-virglrenderer-${pkgver}" \
    "$srcdir/build-virglrenderer"

  meson compile -C "$srcdir/build-virglrenderer"

  # 2. Build QEMU
  cd "$srcdir/winq-emu-qemu-${pkgver}"
  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --target-list=x86_64-softmmu \
    --enable-virglrenderer \
    --enable-opengl \
    --enable-sdl \
    --disable-werror

  make -j$(nproc)
}

package() {
  # Install virglrenderer DLLs and headers
  meson install -C "$srcdir/build-virglrenderer" --destdir "$pkgdir"

  # Install QEMU binaries and artifacts
  cd "$srcdir/winq-emu-qemu-${pkgver}"
  make DESTDIR="$pkgdir" install
}